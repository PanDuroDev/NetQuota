{
  "manifest_version": 3,
  "name": "NetQuota",
  "version": "0.1.0",
  "description": "Local-first data saver: per-site quotas, honest video quality adapters, and a bridge to the NetQuota Windows service.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "nativeMessaging"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "NetQuota",
    "default_popup": "popup.html",
    "default_icon": "icon-128.png"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
